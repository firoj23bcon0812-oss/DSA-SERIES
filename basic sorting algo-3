//selection sorting
#include<iostream>
using namespace std;

int main() {
    int n;

    // insertion sort 
    cout<<"enter the value";
    cin>>n;
    int arr[n];
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }

    for(int i = 0; i <=n-1; i++) {
        int min=i;

        for(int j =i+1; j<=n-1; j++) { // swap from 0 to i

            if(arr[j] < arr[min]) {
                min=j;
            }
        }
        swap(arr[i],arr[min]);
    }

    // Print sorted array
    for(int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
