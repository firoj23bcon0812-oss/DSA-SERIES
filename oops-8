#include<iostream>
using namespace std;
class Complex{
    int real;
    int img;
    public:
    Complex(int real,int img){
        this->real=real;
        this->img=img;
    }
    Complex operator +(Complex &c)
    {
        Complex ans;
        ans.real=real+c.real;
        ans.img=img+c.img;
        return ans;
    }
    void display(){
        cout<<real<<"+i"<<img<<endl;
    }
    
};
int main(){
    return 0;
    Complex c1(2,3);
    c1.display();
    Complex c2(5,4);
    c2.display();
    Complex c3=c1+c2;
    c3.display();
    

}
